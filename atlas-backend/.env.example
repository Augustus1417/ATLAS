# Copy to .env and fill in values before running locally or deploying.

# --- Required ---
DATABASE_URL=postgresql://user:password@host:5432/atlas
OPENROUTER_API_KEY=
SERPER_API_KEY=
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Optional ---
ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API (your frontend URL(s))
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of this API (used for OpenRouter HTTP-Referer header)
PUBLIC_APP_URL=http://localhost:8000
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen-2.5-72b-instruct:free
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Local dev only: use SQLite if PostgreSQL is unreachable (NEVER enable in production)
ALLOW_SQLITE_FALLBACK=false

# Server bind (set PORT on hosts like Render/Railway)
HOST=0.0.0.0
PORT=8000
